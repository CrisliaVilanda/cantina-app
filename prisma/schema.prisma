generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// PRODUTOS / INSUMOS
// ============================================================

model Produto {
  id String @id @default(uuid())

  nome String

  categoria String

  unidadeMedida String

  estoqueMinimo Decimal @db.Decimal(10, 3)

  ativo Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  movimentacoes MovimentacaoEstoque[]

  ingredientes Ingrediente[]
}

// ============================================================
// MOVIMENTAÇÕES DE ESTOQUE
// ============================================================

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
}

model MovimentacaoEstoque {
  id String @id @default(uuid())

  produtoId String

  tipo TipoMovimentacao

  quantidade Decimal @db.Decimal(10, 3)

  custoUnitario Decimal? @db.Decimal(10, 2)

  observacao String?

  createdAt DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id])
}

// ============================================================
// CARDÁPIO
// ============================================================

model Cardapio {
  id String @id @default(uuid())

  nome String

  descricao String?

  categoria String

  precoVenda Decimal @db.Decimal(10, 2)

  ativo Boolean @default(true)

  imagem String?

  ingredientes Ingrediente[]

  itensPedido PedidoItem[]

  vendas Venda[]

  previsoes PrevisaoVenda[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// ============================================================
// FICHA TÉCNICA / INGREDIENTES
// ============================================================

model Ingrediente {
  id String @id @default(uuid())

  cardapioId String

  produtoId String

  quantidade Decimal @db.Decimal(10, 3)

  cardapio Cardapio @relation(fields: [cardapioId], references: [id], onDelete: Cascade)

  produto Produto @relation(fields: [produtoId], references: [id])
}

// ============================================================
// STATUS DO PEDIDO
// ============================================================

enum PedidoStatus {
  PENDENTE
  PREPARO
  PRONTO
  ENTREGUE
}

// ============================================================
// FORMAS DE PAGAMENTO
// ============================================================

enum FormaPagamento {
  PIX
  CREDITO
  DEBITO
  DINHEIRO
}

// ============================================================
// PEDIDO
// ============================================================

model Pedido {
  id String @id @default(uuid())

  numero Int @unique @default(autoincrement())

  cliente String

  status PedidoStatus @default(PENDENTE)

  formaPagamento FormaPagamento

  total Decimal @db.Decimal(10, 2)

  valorRecebido Decimal? @db.Decimal(10, 2)

  troco Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  itens PedidoItem[]

  vendas Venda[]
}

// ============================================================
// ITENS DO PEDIDO
// ============================================================

model PedidoItem {
  id String @id @default(uuid())

  pedidoId String

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  cardapioId String

  cardapio Cardapio @relation(fields: [cardapioId], references: [id])

  quantidade Int

  precoUnitario Decimal @db.Decimal(10, 2)

  subtotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
}

// ============================================================
// VENDA
// ============================================================

model Venda {
  id String @id @default(uuid())

  cardapioId String

  cardapio Cardapio @relation(fields: [cardapioId], references: [id])

  pedidoId String?

  pedido Pedido? @relation(fields: [pedidoId], references: [id])

  quantidade Int

  total Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
}

// ============================================================
// SALDO DIÁRIO
// ============================================================

model SaldoDiario {
  id String @id @default(uuid())

  data DateTime @unique

  totalVendas Int @default(0)

  totalArrecadado Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// ============================================================
// RELATÓRIO MENSAL
// ============================================================

model RelatorioMensal {
  id String @id @default(uuid())

  referencia String

  totalVendas Int

  totalFaturamento Decimal @db.Decimal(10, 2)

  itemMaisVendido String

  categoriaMaisVendida String

  createdAt DateTime @default(now())
}

// ============================================================
// PREVISÃO DE VENDAS
// ============================================================

model PrevisaoVenda {
  id String @id @default(uuid())

  cardapioId String

  previsaoProximaSemana Int

  previsaoProximoMes Int

  createdAt DateTime @default(now())

  cardapio Cardapio @relation(fields: [cardapioId], references: [id])
}

// ============================================================
// CAIXA
// ============================================================

model Caixa {
  id String @id @default(uuid())

  tipo String

  descricao String

  valor Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
}

// ============================================================
// DESPESAS
// ============================================================

model Despesa {
  id String @id @default(uuid())

  descricao String

  valor Decimal @db.Decimal(10, 2)

  categoria String

  createdAt DateTime @default(now())
}

// ============================================================
// USUÁRIOS
// ============================================================

enum PerfilUsuario {
  ADMIN
  ATENDENTE
}

model Usuario {
  id String @id @default(uuid())

  nomeCompleto String

  usuario String @unique

  senhaHash String

  perfil PerfilUsuario

  ativo Boolean @default(true)

  ultimoLogin DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// ============================================================
// LOG DO SISTEMA
// ============================================================

model LogSistema {
  id String @id @default(uuid())

  usuario String

  acao String

  createdAt DateTime @default(now())
}
