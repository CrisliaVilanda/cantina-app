generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Estoque {
  id                  String     @id @default(uuid())
  produto             String
  unidadeMedida       String
  quantidadeAdquirida Int
  quantidadeSaidas    Int
  preco               Decimal    @db.Decimal(10, 2)
  dataAquisicao       DateTime   @default(now())
  cardapios           Cardapio[]
}

model Cardapio {
  id              String   @id @default(uuid())
  nome            String
  descricao       String
  categoria       String
  precoVenda      Decimal  @db.Decimal(10, 2)
  quantidadeVenda Int
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  estoqueId       String

  estoque Estoque @relation(fields: [estoqueId], references: [id])
  vendas  Venda[]
}

model Venda {
  id String @id @default(uuid())

  cardapioId String
  quantidade Int
  total      Decimal @db.Decimal(10, 2)

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id])

  createdAt DateTime @default(now())

  cardapio Cardapio @relation(fields: [cardapioId], references: [id])
}

model SaldoDiario {
  id String @id @default(uuid())

  data DateTime @unique

  totalVendas Int @default(0)

  totalArrecadado Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PedidoStatus {
  PENDENTE
  PREPARO
  PRONTO
  ENTREGUE
}

model Pedido {
  id      String  @id @default(uuid())
  cliente String
  status  String
  total   Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  itens Venda[]
}
