generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ESTOQUE
// ============================================================

model Estoque {
  id                  String   @id @default(uuid())
  produto             String
  unidadeMedida       String
  quantidadeAdquirida Int
  quantidadeSaidas    Int      @default(0)
  preco               Decimal  @db.Decimal(10, 2)
  dataAquisicao       DateTime @default(now())

  cardapios Cardapio[]
}

// ============================================================
// CARDÁPIO
// ============================================================

model Cardapio {
  id String @id @default(uuid())

  nome      String
  descricao String
  categoria String

  precoVenda Decimal @db.Decimal(10, 2)

  quantidadeVenda Int

  ativo Boolean @default(true)

  estoqueId String
  estoque   Estoque @relation(fields: [estoqueId], references: [id])

  vendas Venda[]

  itensPedido PedidoItem[]

  previsoes PrevisaoVenda[]

  createdAt DateTime @default(now())
}

// ============================================================
// STATUS DO PEDIDO
// ============================================================

enum PedidoStatus {
  PENDENTE
  PREPARO
  PRONTO
  ENTREGUE
}

// ============================================================
// FORMAS DE PAGAMENTO
// ============================================================

enum FormaPagamento {
  PIX
  CREDITO
  DEBITO
  DINHEIRO
}

// ============================================================
// PEDIDO
// ============================================================

model Pedido {
  id String @id @default(uuid())

  numero Int @unique @default(autoincrement())

  cliente String

  status PedidoStatus @default(PENDENTE)

  formaPagamento FormaPagamento

  total Decimal @db.Decimal(10, 2)

  valorRecebido Decimal? @db.Decimal(10, 2)

  troco Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  itens PedidoItem[]

  vendas Venda[]
}

// ============================================================
// ITENS DO PEDIDO
// ============================================================

model PedidoItem {
  id String @id @default(uuid())

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  cardapioId String
  cardapio   Cardapio @relation(fields: [cardapioId], references: [id])

  quantidade Int

  precoUnitario Decimal @db.Decimal(10, 2)

  subtotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
}

// ============================================================
// VENDA
// ============================================================

model Venda {
  id String @id @default(uuid())

  cardapioId String
  cardapio   Cardapio @relation(fields: [cardapioId], references: [id])

  pedidoId String?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id])

  quantidade Int

  total Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
}

// ============================================================
// SALDO DIÁRIO
// ============================================================

model SaldoDiario {
  id String @id @default(uuid())

  data DateTime @unique

  totalVendas Int @default(0)

  totalArrecadado Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// ============================================================
// RELATÓRIO MENSAL
// ============================================================

model RelatorioMensal {
  id String @id @default(uuid())

  referencia String

  totalVendas      Int
  totalFaturamento Decimal @db.Decimal(10, 2)

  itemMaisVendido      String
  categoriaMaisVendida String

  createdAt DateTime @default(now())
}

// ============================================================
// HISTÓRICO DE ESTOQUE
// ============================================================

model HistoricoEstoque {
  id String @id @default(uuid())

  produto         String
  quantidadeAtual Int

  createdAt DateTime @default(now())
}

// ============================================================
// PREVISÃO DE VENDAS
// ============================================================

model PrevisaoVenda {
  id String @id @default(uuid())

  cardapioId String

  previsaoProximaSemana Int
  previsaoProximoMes    Int

  createdAt DateTime @default(now())

  cardapio Cardapio @relation(fields: [cardapioId], references: [id])
}

// ============================================================
// CAIXA
// ============================================================

model Caixa {
  id String @id @default(uuid())

  tipo      String
  descricao String

  valor Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
}

// ============================================================
// DESPESAS
// ============================================================

model Despesa {
  id String @id @default(uuid())

  descricao String

  valor Decimal @db.Decimal(10, 2)

  categoria String

  createdAt DateTime @default(now())
}

// ============================================================
// USUÁRIOS
// ============================================================

enum PerfilUsuario {
  ADMIN
  ATENDENTE
}

model Usuario {
  id String @id @default(uuid())

  nomeCompleto String

  usuario String @unique

  senhaHash String

  perfil PerfilUsuario

  ativo Boolean @default(true)

  ultimoLogin DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// ============================================================
// LOG DO SISTEMA
// ============================================================

model LogSistema {
  id String @id @default(uuid())

  usuario String

  acao String

  createdAt DateTime @default(now())
}
